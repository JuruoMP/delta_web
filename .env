# whispercpp related
WHISPER_MODEL_SIZE=base
WHISPER_MODEL_PATH_EN=models/ggml-${WHISPER_MODEL_SIZE}.en.bin
WHISPER_MODEL_PATH_ZH=models/ggml-${WHISPER_MODEL_SIZE}.bin  # 多语言模型本身支持中文识别，无需单独下载中文模型
WHISPER_SAMPLE_RATE=16000

# WhisperX related for speaker diarization
HF_API_KEY=your_hugging_face_api_key_here  # Required for speaker diarization
WHISPERX_ENABLE_DIARIZATION=True  # Set to True to enable speaker diarization
WHISPERX_MODEL_SIZE=base  # WhisperX model size (tiny, base, small, medium, large)
WHISPERX_DEVICE=cpu  # Device to run WhisperX (cpu or cuda)
WHISPERX_ENABLE_SPEAKER_FEATURE=True  # Set to True to enable speaker feature extraction and cross-recording matching
WHISPERX_SPEAKER_MATCHING_THRESHOLD=0.85  # Threshold for speaker matching (0.0-1.0), higher values mean stricter matching